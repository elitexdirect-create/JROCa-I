### 3. WorkflowEngine.ts (packages/automation/src/WorkflowEngine.ts)

```typescript
import { Database } from "@jroc-os/database";
import { EventEmitter } from "events";

export interface Trigger {
  type: string;
  filter?: Record<string, any>;
}

export interface Condition {
  field: string;
  operator: "eq" | "ne" | "gt" | "gte" | "lt" | "lte" | "in" | "contains";
  value: any;
}

export interface Action {
  type: string;
  params: Record<string, any>;
}

export interface Workflow {
  id: string;
  name: string;
  triggers: Trigger[];
  conditions: Condition[];
  actions: Action[];
  enabled: boolean;
  createdAt: Date;
  updatedAt: Date;
}

export class WorkflowEngine extends EventEmitter {
  private db: Database;
  private workflows: Map<string, Workflow>;
  private executionQueue: any[];

  constructor() {
    super();
    this.db = new Database();
    this.workflows = new Map();
    this.executionQueue = [];

    this.loadWorkflows();
    this.registerTriggerHandlers();
  }

  private async loadWorkflows(): Promise<void> {
    const result = await this.db.query(
      `SELECT * FROM workflows WHERE enabled = true`
    );

    for (const row of result.rows) {
      this.workflows.set(row.id, row);
    }
  }

  private registerTriggerHandlers(): void {
    // Register handlers for each trigger type
    this.on("lead_created", (data) => this.handleTrigger("lead_created", data));
    this.on("deal_updated", (data) => this.handleTrigger("deal_updated", data));
    this.on("email_received", (data) =>
      this.handleTrigger("email_received", data)
    );
    this.on("scheduled_task", (data) =>
      this.handleTrigger("scheduled_task", data)
    );
  }

  private async handleTrigger(
    triggerType: string,
    data: Record<string, any>
  ): Promise<void> {
    for (const [workflowId, workflow] of this.workflows.entries()) {
      const trigger = workflow.triggers.find((t) => t.type === triggerType);

      if (!trigger) continue;

      // Check filter
      if (trigger.filter && !this.matchesFilter(data, trigger.filter)) {
        continue;
      }

      // Check conditions
      if (!this.evaluateConditions(data, workflow.conditions)) {
        continue;
      }

      // Execute actions
      await this.executeActions(workflow.actions, data);

      // Log execution
      await this.db.query(
        `INSERT INTO workflow_executions (workflow_id, trigger_type, status, data)
         VALUES ($1, $2, $3, $4)`,
        [workflowId, triggerType, "completed", JSON.stringify(data)]
      );
    }
  }

  private matchesFilter(
    data: Record<string, any>,
    filter: Record<string, any>
  ): boolean {
    for (const [key, value] of Object.entries(filter)) {
      if (data[key] !== value) return false;
    }
    return true;
  }

  private evaluateConditions(
    data: Record<string, any>,
    conditions: Condition[]
  ): boolean {
    for (const condition of conditions) {
      const fieldValue = data[condition.field];

      switch (condition.operator) {
        case "eq":
          if (fieldValue !== condition.value) return false;
          break;
        case "gt":
          if (fieldValue <= condition.value) return false;
          break;
        case "gte":
          if (fieldValue < condition.value) return false;
          break;
        case "in":
          if (!condition.value.includes(fieldValue)) return false;
