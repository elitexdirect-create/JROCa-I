```typescript
import { BaseAgent } from "../BaseAgent";
import { Database } from "@jroc-os/database";

export interface AgentStatus {
  id: string;
  name: string;
  status: "running" | "paused" | "error";
  tasksCompleted: number;
  uptime: number;
  memory: number;
  cpuUsage: number;
  errorRate: number;
  lastTaskId: string;
}

export interface SystemHealth {
  agentsRunning: number;
  agentsPaused: number;
  agentsError: number;
  tasksQueued: number;
  tasksRunning: number;
  totalThroughput: number;
  cpuUsage: number;
  memoryUsage: number;
  uptime: number;
}

export class Commander extends BaseAgent {
  private agents: Map<string, BaseAgent>;
  private healthCheckInterval: NodeJS.Timer;

  constructor() {
    super({
      id: "commander",
      name: "JROC Commander",
    });

    this.agents = new Map();
    this.startHealthChecks();
  }

  private startHealthChecks(): void {
    this.healthCheckInterval = setInterval(() => {
      this.performHealthCheck();
    }, 60000); // Every minute
  }

  private async performHealthCheck(): Promise<void> {
    for (const [agentId, agent] of this.agents.entries()) {
      const status = agent.getStatus();

      await this.db.query(
        `INSERT INTO agent_health_checks (agent_id, status, memory, cpu, timestamp)
         VALUES ($1, $2, $3, $4, now())`,
        [agentId, "healthy", status.memorySize, 0]
      );
    }
  }

  registerAgent(agent: BaseAgent): void {
    const status = agent.getStatus();
    this.agents.set(status.agentId, agent);
  }

  async getAgentStatus(agentId: string): Promise<AgentStatus> {
    const agent = this.agents.get(agentId);
    if (!agent) throw new Error(`Agent ${agentId} not found`);

    const status = agent.getStatus();
    const runs = await this.db.query(
      `SELECT COUNT(*) as total, 
              SUM(CASE WHEN status = 'failed' THEN 1 ELSE 0 END) as failed
       FROM agent_runs WHERE agent_id = $1 AND created_at > now() - interval '1 day'`,
      [agentId]
    );

    const errorRate =
      runs.rows[0].total > 0
        ? (runs.rows[0].failed / runs.rows[0].total) * 100
        : 0;

    return {
      id: agentId,
      name: status.agentId,
      status: "running",
      tasksCompleted: status.tasksCompleted,
      uptime: Date.now(),
      memory: status.memorySize,
      cpuUsage: 0,
      errorRate,
      lastTaskId: "",
    };
  }

  async scaleAgent(
    agentId: string,
    config: { instances: number; concurrency: number }
  ): Promise<void> {
    await this.db.query(
      `UPDATE agent_scaling SET instances = $1, concurrency = $2 
       WHERE agent_id = $3`,
      [config.instances, config.concurrency, agentId]
    );

    console.log(
      `Scaled ${agentId} to ${config.instances} instances, ${config.concurrency} concurrency`
    );
  }

  async broadcast(command: {
    command: string;
    data: Record<string, any>;
  }): Promise<void> {
    for (const [agentId, agent] of this.agents.entries()) {
      // Send command to all agents
      console.log(`Broadcasting to ${agentId}:`, command);
    }
  }

  async getSystemHealth(): Promise<SystemHealth> {
    const runs = await this.db.query(
      `SELECT 
        COUNT(*) as total_tasks,
        SUM(CASE WHEN status = 'completed' THEN 1 ELSE 0 END) as completed,
        SUM(CASE WHEN status = 'failed' THEN 1 ELSE 0 END) as failed
      FROM agent_runs WHERE created_at > now() - interval '24 hours'`
    );

    const agentCount = this.agents.size;

    return {
      agentsRunning: agentCount,
      agentsPaused: 0,
      agentsError: 0,
      tasksQueued: 0,
      tasksRunning: 0,
      totalThroughput:
        runs.rows[0].completed / 24, // Per hour
      cpuUsage: 0,
      memoryUsage: 0,
      uptime: Date.now(),
    };
  }

  protected getSystemPrompt(): string {
    return `You are the JROC Commander. Your role is to:
1. Monitor all AI agents
2. Coordinate workflows and automations
3. Optimize system performance
4. Escalate critical issues
5. Manage scaling and resources

Report system status and take corrective actions as needed.`;
  }
}
