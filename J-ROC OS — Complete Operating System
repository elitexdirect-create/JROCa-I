## 🧠 AI Agent Framework

### Creating a Custom Agent

```typescript
import { BaseAgent, Tool, AgentTask } from '@jroc-os/agents';
import { Anthropic } from '@anthropic-ai/sdk';

class CustomSalesAgent extends BaseAgent {
  constructor() {
    super({
      id: 'custom-sales-agent',
      name: 'Custom Sales Agent',
      model: 'claude-3-5-sonnet-20241022',
      maxTokens: 4096,
      temperature: 0.7,
    });
  }

  // Define tools this agent can use
  protected initializeTools(): Tool[] {
    return [
      {
        name: 'send_email',
        description: 'Send an email to a prospect',
        execute: async (params) => this.emailService.send(params),
      },
      {
        name: 'search_company',
        description: 'Search company info',
        execute: async (params) => this.companyService.search(params),
      },
      {
        name: 'log_activity',
        description: 'Log activity in CRM',
        execute: async (params) => this.crmService.logActivity(params),
      },
    ];
  }

  // Define agent system prompt
  protected getSystemPrompt(): string {
    return `You are an expert sales development representative. Your job is to:
1. Research prospects
2. Send personalized outreach emails
3. Track all interactions in the CRM
4. Always maintain professionalism and compliance`;
  }
}

// Use agent
const agent = new CustomSalesAgent();
const task = new AgentTask({
  type: 'outreach',
  prospect: 'john@company.com',
  company: 'Acme Corp',
});

const result = await agent.execute(task);
console.log(result.status); // 'completed' | 'escalated' | 'failed'
```

