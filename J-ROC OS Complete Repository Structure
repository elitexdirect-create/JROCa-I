### 1. BaseAgent.ts (packages/agents/src/BaseAgent.ts)

```typescript
import Anthropic from "@anthropic-ai/sdk";
import { Database } from "@jroc-os/database";

export interface Tool {
  name: string;
  description: string;
  inputSchema: Record<string, any>;
  execute: (params: Record<string, any>) => Promise<any>;
}

export interface AgentConfig {
  id: string;
  name: string;
  model?: string;
  maxTokens?: number;
  temperature?: number;
  systemPrompt?: string;
}

export interface AgentTask {
  id: string;
  type: string;
  input: Record<string, any>;
  status: "pending" | "running" | "completed" | "failed" | "escalated";
  priority: number;
  createdAt: Date;
  completedAt?: Date;
  result?: Record<string, any>;
  error?: string;
}

export class BaseAgent {
  protected client: Anthropic;
  protected db: Database;
  protected config: AgentConfig;
  protected tools: Map<string, Tool>;
  protected memory: Map<string, any>;
  protected taskQueue: AgentTask[];

  constructor(config: AgentConfig) {
    this.config = {
      model: "claude-3-5-sonnet-20241022",
      maxTokens: 4096,
      temperature: 0.7,
      ...config,
    };

    this.client = new Anthropic({
      apiKey: process.env.ANTHROPIC_API_KEY,
    });

    this.db = new Database();
    this.tools = new Map();
    this.memory = new Map();
    this.taskQueue = [];

    this.initializeTools();
  }

  protected initializeTools(): void {
    // Override in subclass
  }

  protected getSystemPrompt(): string {
    return this.config.systemPrompt || "You are a helpful AI assistant.";
  }

  protected registerTool(tool: Tool): void {
    this.tools.set(tool.name, tool);
  }

  async execute(task: AgentTask): Promise<AgentTask> {
    task.status = "running";
    const startTime = Date.now();

    try {
      // Get context from memory & DB
      const context = await this.buildContext(task);

      // Call Claude API with tools
      const response = await this.client.messages.create({
        model: this.config.model!,
        max_tokens: this.config.maxTokens!,
        temperature: this.config.temperature,
        system: this.getSystemPrompt(),
        tools: Array.from(this.tools.values()).map((tool) => ({
          name: tool.name,
          description: tool.description,
          input_schema: {
            type: "object",
            properties: tool.inputSchema,
          },
        })),
        messages: [
          {
            role: "user",
            content: `Task: ${task.type}\nInput: ${JSON.stringify(
              task.input
            )}\n\nContext: ${context}`,
          },
        ],
      });

      // Process response
      task.result = await this.processResponse(response, task);
      task.status = "completed";

      // Log run
      await this.db.query(
        `INSERT INTO agent_runs (agent_id, task_type, status, input, output, duration_ms)
         VALUES ($1, $2, $3, $4, $5, $6)`,
        [
          this.config.id,
          task.type,
          "completed",
          task.input,
          task.result,
          Date.now() - startTime,
        ]
      );
    } catch (error) {
      task.status = "failed";
      task.error = (error as Error).message;

      await this.db.query(
        `INSERT INTO agent_runs (agent_id, task_type, status, error, duration_ms)
         VALUES ($1, $2, $3, $4, $5)`,
        [
          this.config.id,
          task.type,
          "failed",
          task.error,
          Date.now() - startTime,
        ]
      );
    }

    return task;
  }

  private async buildContext(task: AgentTask): Promise<string> {
    // Load relevant context from memory & DB
    const memoryContext = JSON.stringify(
      Array.from(this.memory.entries())
        .slice(-10)
        .map(([key, value]) => ({ key, value }))
    );

    return `Memory: ${memoryContext}`;
  }

  private async processResponse(
    response: Anthropic.Message,
    task: AgentTask
  ): Promise<Record<string, any>> {
    const result: Record<string, any> = {};

    for (const content of response.content) {
      if (content.type === "text") {
        result.text = content.text;
      } else if (content.type === "tool_use") {
        const tool = this.tools.get(content.name);
        if (tool) {
          result[content.name] = await tool.execute(content.input as any);
        }
      }
    }

    return result;
  }

  async saveToMemory(key: string, value: any): Promise<void> {
    this.memory.set(key, value);
    // Persist to DB for long-term memory
    await this.db.query(
      `INSERT INTO agent_memory (agent_id, key, value, created_at)
       VALUES ($1, $2, $3, now())`,
      [this.config.id, key, JSON.stringify(value)]
    );
  }

  getStatus(): {
    agentId: string;
    status: string;
    tasksCompleted: number;
    memorySize: number;
  } {
    return {
      agentId: this.config.id,
      status: "running",
      tasksCompleted: this.taskQueue.length,
      memorySize: this.memory.size,
    };
  }
}
