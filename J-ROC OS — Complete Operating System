## 🔄 Automation Engine

### Creating a Workflow

```typescript
import { Workflow, Trigger, Condition, Action } from '@jroc-os/automation';

const leadQualificationWorkflow = new Workflow({
  id: 'lead-qualification',
  name: 'Auto Qualify Leads',
  description: 'Automatically qualify and assign leads',
  enabled: true,
  triggers: [
    {
      type: 'lead_created',
      filter: { source: 'website_form' },
    },
  ],
  conditions: [
    {
      field: 'company_revenue',
      operator: 'gte',
      value: 10000000, // $10M+
    },
  ],
  actions: [
    {
      type: 'send_email_sequence',
      agentId: 'sdr-agent',
      sequenceId: 'welcome-sequence',
    },
    {
      type: 'assign_owner',
      assignTo: 'sales_team',
    },
    {
      type: 'create_task',
      taskType: 'follow_up',
      dueIn: 'P1D', // 1 day
    },
  ],
});

await workflow.deploy();
```

