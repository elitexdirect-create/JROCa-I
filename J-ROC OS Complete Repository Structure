import { BaseAgent, Tool, AgentTask } from "../BaseAgent";
import axios from "axios";

export class SDRAgent extends BaseAgent {
  constructor() {
    super({
      id: "sdr-agent",
      name: "Sales Development Representative",
      temperature: 0.7,
    });
  }

  protected initializeTools(): void {
    this.registerTool({
      name: "send_email",
      description:
        "Send a personalized email to a prospect with subject and body",
      inputSchema: {
        to: { type: "string", description: "Recipient email" },
        subject: { type: "string", description: "Email subject line" },
        body: { type: "string", description: "Email body content" },
        template: {
          type: "string",
          description: "Optional email template name",
        },
      },
      execute: async (params) => {
        // Send via email service
        const response = await axios.post("/api/emails/send", {
          to: params.to,
          subject: params.subject,
          body: params.body,
          template: params.template,
        });
        return { status: "sent", messageId: response.data.id };
      },
    });

    this.registerTool({
      name: "search_prospect",
      description: "Search for prospect information",
      inputSchema: {
        email: { type: "string" },
        company: { type: "string" },
        linkedin: { type: "string" },
      },
      execute: async (params) => {
        // Search API (Apollo, RocketReach, etc)
        const response = await axios.get("/api/search/prospect", {
          params,
        });
        return response.data;
      },
    });

    this.registerTool({
      name: "log_activity",
      description: "Log activity in CRM",
      inputSchema: {
        contactId: { type: "string" },
        type: {
          type: "string",
          enum: ["email", "call", "meeting", "note"],
        },
        details: { type: "string" },
      },
      execute: async (params) => {
        await this.db.query(
          `INSERT INTO activities (contact_id, type, details, created_at)
           VALUES ($1, $2, $3, now())`,
          [params.contactId, params.type, params.details]
        );
        return { status: "logged" };
      },
    });

    this.registerTool({
      name: "create_task",
      description: "Create follow-up task",
      inputSchema: {
        contactId: { type: "string" },
        dueDate: { type: "string" },
        description: { type: "string" },
        priority: { type: "string", enum: ["high", "medium", "low"] },
      },
      execute: async (params) => {
        const result = await this.db.query(
          `INSERT INTO tasks (contact_id, due_date, description, priority)
           VALUES ($1, $2, $3, $4) RETURNING id`,
          [params.contactId, params.dueDate, params.description, params.priority]
        );
        return { taskId: result.rows[0].id };
      },
    });
  }

  protected getSystemPrompt(): string {
    return `You are an expert sales development representative. Your role is to:
1. Research prospects thoroughly
2. Personalize outreach emails based on their background and pain points
3. Schedule follow-ups intelligently
4. Log all interactions in the CRM
5. Always maintain professionalism and compliance

Guidelines:
- Never send generic emails - always personalize
- Respect email frequency - don't spam
- Track all activities for reporting
- Escalate difficult prospects to human SDR
- Focus on value-first messaging`;
  }
}
